#!/usr/bin/env bash
# Renders the app with Timoni and Kapitan and exits 0 only if both produce
# the same manifests for each environment (EX-22). Timoni builds the bundle
# from the module that check pushes to a registry on localhost:5001, pinned
# by the digest of that push. Then fails unless Timoni rejects the pinned
# bundle after another push moved the tag, and rejects a misspelled value
# that Kapitan compiles.
# Needs timoni, docker, curl, jq and uv; gh and oras on first run and after
# the generator pin changed.
set -euo pipefail
cd "$(dirname "$0")"
out=$(mktemp -d)
registry=
cleanup() {
  [[ -z $registry ]] || docker rm -f "$registry" >/dev/null
  rm -rf -- "$out"
}
trap cleanup EXIT
py=(uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4)
# renovate: datasource=docker depName=mirror.gcr.io/library/registry
REGISTRY_IMAGE=mirror.gcr.io/library/registry:3.1.2@sha256:38907510915c3f1604c7e83d6ab602ab3020d092f73bdaed8696773693ff768c
export TIMONI_CACHING=false

# Fetch the pinned kadet-hub generator: check its attestation, then pull by digest.
# kapitan/lib/kubernetes/.ref names the digest pulled before; a changed pin pulls again.
src=$(grep -o 'ghcr.io/kadet-hub/kubernetes:[^ ]*' kapitan/inventory/classes/common.yml)
ref=${src%%:*}@${src#*@}
if [[ ! -f kapitan/lib/kubernetes/.ref || $(<kapitan/lib/kubernetes/.ref) != "$ref" ]]; then
  gh attestation verify "oci://$ref" --owner kadet-hub \
    --cert-identity https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main >/dev/null
  oras pull -o "$out/oci" "$ref" >/dev/null
  rm -rf -- kapitan/lib/kubernetes
  mkdir -p kapitan/lib/kubernetes
  tar -xf "$out/oci/kubernetes.tar" -C kapitan/lib/kubernetes
  echo "$ref" >kapitan/lib/kubernetes/.ref
fi
(cd kapitan && "${py[@]}" kapitan compile --output-path "$out" >"$out/kapitan.log" 2>&1) \
  || { cat "$out/kapitan.log"; exit 1; }

# Publish the module as its author would, then pin the bundle to that push.
registry=$(docker run -d -p 127.0.0.1:5001:5000 "$REGISTRY_IMAGE")
for _ in {1..20}; do
  curl -fs http://localhost:5001/v2/ >/dev/null && break
  sleep 0.5
done
digest=$(timoni mod push timoni/app oci://localhost:5001/modules/app -v 1.0.0 -o json | jq -er .digest)
echo "bundle: instances: [string]: module: digest: \"$digest\"" >"$out/pin.cue"
build() { timoni bundle build -f timoni/shop.cue -f "$@"; }

# One document per object, sorted by kind/namespace/name, keys sorted. The
# app.kubernetes.io/managed-by label names the tool and only Kapitan sets it,
# so it is dropped. Nothing else is ignored.
normalize() {
  "${py[@]}" python -I -c '
import sys, yaml
def strip(o):
    if isinstance(o, dict):
        o.pop("app.kubernetes.io/managed-by", None)
        for v in o.values(): strip(v)
    elif isinstance(o, list):
        for v in o: strip(v)
docs = [d for d in yaml.safe_load_all(sys.stdin) if d]
for d in docs: strip(d)
docs.sort(key=lambda d: (d["kind"], d["metadata"].get("namespace", ""), d["metadata"]["name"]))
sys.stdout.write(yaml.safe_dump_all(docs, sort_keys=True))
'
}

status=0
for env in dev prod; do
  build "timoni/$env.cue" -f "$out/pin.cue" | normalize >"$out/$env.timoni"
  find "$out/compiled/$env/manifests" -name '*.yaml' -exec sh -c 'cat "$1"; echo ---' _ {} \; \
    | normalize >"$out/$env.kapitan"
  if diff -u "$out/$env.kapitan" "$out/$env.timoni"; then
    echo "$env: timoni = kapitan ($(grep -c '^kind:' "$out/$env.timoni") objects)"
  else
    status=1
  fi
done

# A misspelled key in prod: replica instead of replicas for web.
sed 's/^\t\treplicas: 3$/\t\treplica:  3/' timoni/prod.cue >"$out/typo.cue"
if build "$out/typo.cue" -f "$out/pin.cue" >/dev/null 2>"$out/typo.log"; then
  echo "timoni built the bundle with replica" >&2
  status=1
elif grep -q 'replica: field not allowed' "$out/typo.log"; then
  echo "timoni: replica rejected ($(grep -o 'replica: field not allowed' "$out/typo.log"))"
else
  cat "$out/typo.log" >&2
  status=1
fi
cp -r kapitan "$out/kapitan-typo"
sed -i 's/^      replicas: 3$/      replica: 3/' "$out/kapitan-typo/inventory/targets/prod.yml"
(cd "$out/kapitan-typo" && "${py[@]}" kapitan compile -t prod --output-path . >"$out/kapitan-typo.log" 2>&1) \
  || { cat "$out/kapitan-typo.log"; exit 1; }
if grep -qx '  replicas: 1' "$out/kapitan-typo/compiled/prod/manifests/shop/web-deploy.yaml"; then
  echo "kapitan: replica compiled, web gets replicas: 1"
else
  echo "kapitan compiled replica without falling back to one replica" >&2
  status=1
fi

# Another push moves the tag 1.0.0 to a module whose pods pull Always. The
# pinned bundle must fail; without the pin the bundle builds the new push.
cp -r timoni/app "$out/app"
sed -i 's/imagePullPolicy: "IfNotPresent"/imagePullPolicy: "Always"/' "$out/app/templates/deployment.cue"
timoni mod push "$out/app" oci://localhost:5001/modules/app -v 1.0.0 >"$out/push.log" 2>&1 \
  || { cat "$out/push.log"; exit 1; }
if build timoni/prod.cue -f "$out/pin.cue" >/dev/null 2>"$out/moved.log"; then
  echo "timoni built the pinned bundle after the tag moved" >&2
  status=1
elif grep -q "of version 1.0.0 doesn't match the specified digest $digest" "$out/moved.log"; then
  echo "timoni: pinned bundle rejected after the tag moved (digest doesn't match)"
else
  cat "$out/moved.log" >&2
  status=1
fi
if build timoni/prod.cue | grep -q 'imagePullPolicy: Always'; then
  echo "timoni: unpinned bundle built the new push"
else
  echo "timoni did not build the new push without the pin" >&2
  status=1
fi
exit $status
