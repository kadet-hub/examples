{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "github>kadet-hub/renovate-config"
  ],
  "constraints": {
    "npm": "<12"
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "EX-3: tool versions marked with a renovate comment; release-asset and image pins carry their checksum along, repository files their commit",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/[^/]+\\.yml$/",
        "/^[^/]+/(check|run)$/",
        "kubevirt-csi/inventory/targets/infra.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases|node-version|docker) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+[=:] ?\"?(?<currentValue>[^\"\\s:@]+)\"?\\n",
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+[=:] ?\"?(?<currentValue>[^\"\\s]+)\"?\\n\\s*[A-Z_]+_SHA(?:256|512)[=:] ?\"?(?<currentDigest>[0-9a-f]{64,128})\"?",
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+[=:] ?\"?\\S+?:(?<currentValue>[^@\"\\s:]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"?",
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+_COMMIT[=:] ?(?<currentDigest>[0-9a-f]{40}) # (?<currentValue>\\S+)"
      ]
    },
    {
      "description": "EX-3: charts by version and the digest of their OCI artifact, images by tag or tag and digest, in inventories and manifests",
      "customType": "regex",
      "managerFilePatterns": [
        "**/inventory/**/*.yml",
        "*/tests/**/*.yaml",
        "argocd-vs-flux/git-server.yaml"
      ],
      "matchStrings": [
        "source: oci://(?<depName>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})\\n\\s*chart_name: \\S+\\n\\s*version: (?<currentValue>\\S+)",
        "image(?:_name)?(?:: |=)(?<depName>[a-z0-9.-]+\\.[a-z]+/[^:@\\s]+):(?<currentValue>[^@\\s]+)(?:@(?<currentDigest>sha256:[0-9a-f]{64}))?",
        "repository: (?<depName>\\S+)\\n\\s*tag: \"?(?<currentValue>[^\"\\s]+)\"?\\n\\s*digest: (?<currentDigest>sha256:[0-9a-f]{64})",
        "\\n\\s+(?<depName>[a-z0-9.-]+\\.[a-z]+/[^:@\\s]+):\\n\\s+tag: (?<currentValue>\\S+)\\n\\s+digest: (?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "EX-3: Python packages pinned with == in the scripts' uv run --with and uvx",
      "customType": "regex",
      "managerFilePatterns": [
        "/^[^/]+/(check|run\\.sh)$/"
      ],
      "matchStrings": [
        "--(?:with|from) '?(?<depName>[A-Za-z0-9_.-]+)(?:\\[[^\\]]*\\])?==(?<currentValue>[^'\\s)]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ],
  "customDatasources": {
    "opentofu-provider": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/opentofu/registry/main/providers/{{replace '^(.).*$' '$1' packageName}}/{{packageName}}.json",
      "transformTemplates": [
        "{\"sourceUrl\": \"https://github.com/{{replace '/' '/terraform-provider-' packageName}}\", \"releases\": [versions.{\"version\": version, \"releaseTimestamp\": discovered}]}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "EX-3: an operator's chart and images in one pull request, so that the chart's CRDs run with the operator version they belong to",
      "matchFileNames": [
        "cert-manager-mutate/inventory/classes/cert-manager.yml",
        "cert-manager-mutate/inventory/classes/trust-manager.yml"
      ],
      "groupName": "{{replace '^.+/([^/]+)\\.yml$' '$1' packageFile}} operator"
    },
    {
      "description": "EX-3: the Kapitan side of chart-vs-kapitan runs the image tags of the chart it rebuilds, which the chart's pull request sets; Renovate updates only the digest of a pinned tag. cert-manager has its group below",
      "matchFileNames": [
        "chart-vs-kapitan/kapitan/inventory/targets/*.yml",
        "!chart-vs-kapitan/kapitan/inventory/targets/cert-manager.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "EX-3: so do the version and sha256 of the Prometheus Operator CRDs that chart-vs-kapitan/check downloads for the Kapitan side",
      "matchFileNames": [
        "chart-vs-kapitan/check"
      ],
      "matchDepNames": [
        "prometheus-operator/prometheus-operator"
      ],
      "enabled": false
    },
    {
      "description": "EX-3: cert-manager's chart, CRDs and four images in chart-vs-kapitan share one version and move in one pull request, created only once all six have an update; the CRDs' release age holds it back three days (EX-3b)",
      "matchFileNames": [
        "chart-vs-kapitan/check",
        "chart-vs-kapitan/kapitan/inventory/targets/cert-manager.yml"
      ],
      "matchPackageNames": [
        "quay.io/jetstack/charts/cert-manager",
        "cert-manager/cert-manager",
        "quay.io/jetstack/cert-manager-controller",
        "quay.io/jetstack/cert-manager-cainjector",
        "quay.io/jetstack/cert-manager-webhook",
        "quay.io/jetstack/cert-manager-acmesolver"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "groupName": "chart-vs-kapitan cert-manager",
      "minimumGroupSize": 6
    },
    {
      "description": "EX-3: kind and the node image of its release",
      "matchDepNames": [
        "kubernetes-sigs/kind",
        "kindest/node"
      ],
      "groupName": "kind"
    },
    {
      "description": "EX-3: podinfo's chart and the image that pin-image pins",
      "matchPackageNames": [
        "ghcr.io/stefanprodan/charts/podinfo",
        "ghcr.io/stefanprodan/podinfo"
      ],
      "groupName": "podinfo"
    },
    {
      "description": "EX-3: the Pulumi Kubernetes plugin at the @pulumi/kubernetes version",
      "matchPackageNames": [
        "@pulumi/kubernetes",
        "pulumi/pulumi-kubernetes"
      ],
      "groupName": "pulumi-kubernetes"
    },
    {
      "description": "EX-7: the redis tag follows Argo CD's manifest; Renovate updates its digest only",
      "matchPackageNames": [
        "mirror.gcr.io/library/redis"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "Runners stay on ubuntu-24.04, the runner the posts name",
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    },
    {
      "description": "first-platform pins requires-python to what Kapitan 0.36.3 is used with in the post",
      "matchManagers": [
        "pep621"
      ],
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "Image names in the examples are placeholders",
      "matchPackageNames": [
        "ghcr.io/example/**"
      ],
      "enabled": false
    },
    {
      "description": "Kapitan 0.36.3's omegaconf backend needs ListMergeMode, which omegaconf 2.4.0 removed (kapicorp/kapitan#1621)",
      "matchPackageNames": [
        "omegaconf"
      ],
      "allowedVersions": "/^2\\.4\\.0\\.dev4$/"
    },
    {
      "description": "gVisor tags are release-YYYYMMDD.N",
      "matchDepNames": [
        "google/gvisor"
      ],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "description": "config-tools stays on the TypeScript 5.9 line that the cdk8s template and ts-node 10 use",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6"
    },
    {
      "description": "EX-3a: gvisor-ci/run also runs the escape scripts on the host's Python 3.13, so its rootfs image stays on 3.13",
      "matchFileNames": [
        "gvisor-ci/run"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.14"
    },
    {
      "description": "EX-3b: OpenTofu providers age from the registry's discovery of the version; api.opentofu.org dates them by the tagged commit",
      "matchDatasources": [
        "terraform-provider"
      ],
      "matchRegistryUrls": [
        "https://registry.opentofu.org"
      ],
      "overrideDatasource": "custom.opentofu-provider",
      "registryUrls": []
    },
    {
      "description": "EX-3b: registries other than Docker Hub report no release timestamp",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^[^/]*[.:][^/]*//",
        "!/^(docker\\.io|index\\.docker\\.io)//"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "EX-3e: a rebuilt tag's new digest goes through at once; Docker Hub dates it by the push",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "EX-3b: Node.js release dates have day precision",
      "matchDatasources": [
        "node-version"
      ],
      "minimumReleaseAge": "4 days"
    }
  ]
}
