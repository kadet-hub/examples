#!/usr/bin/env bash
# Renders the app with Helm, Helmfile, Kustomize, Pulumi and Kapitan and exits
# 0 only if all five produce the same manifests for each environment.
# Needs helm, helmfile, kustomize, pulumi, node/npm and uv; gh and oras on first run
# and after the generator pin changed. PULUMI_KUBERNETES_SHA256, if set, is the expected
# sha256 of the provider plugin archive.
set -euo pipefail
cd "$(dirname "$0")"
out=$(mktemp -d)
trap 'rm -rf -- "$out"' EXIT
py=(uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4)

# Fetch the pinned kadet-hub generator: check its attestation, then pull by digest.
# kapitan/lib/kubernetes/.ref names the digest pulled before; a changed pin pulls again.
src=$(grep -o 'ghcr.io/kadet-hub/kubernetes:[^ ]*' kapitan/inventory/classes/common.yml)
ref=${src%%:*}@${src#*@}
if [[ ! -f kapitan/lib/kubernetes/.ref || $(<kapitan/lib/kubernetes/.ref) != "$ref" ]]; then
  gh attestation verify "oci://$ref" --owner kadet-hub \
    --cert-identity https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main >/dev/null
  oras pull -o "$out/oci" "$ref" >/dev/null
  rm -rf -- kapitan/lib/kubernetes
  mkdir -p kapitan/lib/kubernetes
  tar -xf "$out/oci/kubernetes.tar" -C kapitan/lib/kubernetes
  echo "$ref" >kapitan/lib/kubernetes/.ref
fi

# Pulumi: npm packages from the lock file without install scripts, because
# the one in @pulumi/kubernetes downloads the provider plugin unchecked. The
# plugin is installed at the locked version instead and automatic plugin
# downloads are off. State goes to a local file backend, not Pulumi Cloud, and
# no kubeconfig is read.
[[ -d pulumi/node_modules ]] || (cd pulumi && npm ci --ignore-scripts --no-audit --no-fund >/dev/null)
rm -rf pulumi/rendered pulumi/Pulumi.*.yaml
mkdir "$out/pulumi"
(
  cd pulumi
  pulumi plugin install resource kubernetes "$(node -p 'require("@pulumi/kubernetes/package.json").version')" \
    ${PULUMI_KUBERNETES_SHA256:+--checksum "$PULUMI_KUBERNETES_SHA256"} || exit
  export PULUMI_BACKEND_URL="file://$out/pulumi" PULUMI_CONFIG_PASSPHRASE='' KUBECONFIG=/dev/null \
    PULUMI_SKIP_UPDATE_CHECK=true PULUMI_DISABLE_AUTOMATIC_PLUGIN_ACQUISITION=true
  for env in dev prod; do
    pulumi stack init "$env" && pulumi up --yes --skip-preview --non-interactive --stack "$env" || exit
  done
) >"$out/pulumi.log" 2>&1 || { cat "$out/pulumi.log"; exit 1; }

(cd kapitan && "${py[@]}" kapitan compile --output-path "$out" >"$out/kapitan.log" 2>&1) \
  || { cat "$out/kapitan.log"; exit 1; }

# One document per object, sorted by kind/namespace/name, keys sorted. The
# managed-by label names the tool (Helm vs kapitan) and is dropped. Pulumi
# omits initialDelaySeconds: 0, the API default, so it is dropped as well.
normalize() {
  "${py[@]}" python -I -c '
import sys, yaml
def strip(o):
    if isinstance(o, dict):
        o.pop("app.kubernetes.io/managed-by", None)
        if o.get("initialDelaySeconds") == 0: del o["initialDelaySeconds"]
        for v in o.values(): strip(v)
    elif isinstance(o, list):
        for v in o: strip(v)
docs = [d for d in yaml.safe_load_all(sys.stdin) if d]
for d in docs: strip(d)
docs.sort(key=lambda d: (d["kind"], d["metadata"].get("namespace", ""), d["metadata"]["name"]))
sys.stdout.write(yaml.safe_dump_all(docs, sort_keys=True))
'
}

status=0
for env in dev prod; do
  for app in helm/values/*-"$env".yaml; do
    name=$(basename "$app" "-$env.yaml")
    helm template "$name" helm/app -n shop -f "helm/values/$name.yaml" -f "$app"
    echo ---
  done | normalize >"$out/$env.helm"
  helmfile -f helmfile/helmfile.yaml.gotmpl -e "$env" template --quiet | normalize >"$out/$env.helmfile"
  kustomize build "kustomize/overlays/$env" | normalize >"$out/$env.kustomize"
  find "$out/compiled/$env/manifests" -name '*.yaml' -exec sh -c 'cat "$1"; echo ---' _ {} \; \
    | normalize >"$out/$env.kapitan"
  find "pulumi/rendered/$env" -name '*.yaml' -exec sh -c 'cat "$1"; echo ---' _ {} \; \
    | normalize >"$out/$env.pulumi"
  for tool in helm helmfile kustomize pulumi; do
    if diff -u "$out/$env.kapitan" "$out/$env.$tool"; then
      echo "$env: $tool = kapitan ($(grep -c '^kind:' "$out/$env.$tool") objects)"
    else
      status=1
    fi
  done
done
exit $status
