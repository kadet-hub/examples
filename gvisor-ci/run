#!/usr/bin/env bash
# Run the three escape scripts, first unconfined, then inside a gVisor
# sandbox with --network=none and a read-only minimal rootfs.
#
# Requires: runsc on PATH, uv (for a pinned Python 3.13), docker only to
# export a rootfs image once. Nothing here needs root; runsc runs rootless.
set -euo pipefail
here=$(cd -- "$(dirname -- "$0")" && pwd)
# renovate: datasource=docker depName=python
PYTHON_IMAGE=python:3.13-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
export XDG_RUNTIME_DIR=$work/run; mkdir -p "$XDG_RUNTIME_DIR"

echo "## Unconfined (host Python 3.13 via uv)"
for s in audit_hook_bypass dns_vs_rawip home_escape; do
  echo "### $s"; uv run --python 3.13 python -I "$here/$s.py" || true
done

echo "## Build a minimal read-only rootfs from $PYTHON_IMAGE"
mkdir -p "$work/bundle/rootfs"
cid=$(docker create "$PYTHON_IMAGE" sleep 1)
docker export "$cid" | tar -C "$work/bundle/rootfs" -xf -
docker rm "$cid" >/dev/null
cp "$here"/*.py "$work/bundle/rootfs/"
( cd "$work/bundle" && runsc spec )

run_in_gvisor() {  # $1 = script name without .py
  python3 - "$work" "$1" <<'PY'
import json, sys
work, script = sys.argv[1], sys.argv[2]
c = json.load(open(f"{work}/bundle/config.json"))
c["process"]["args"] = ["/usr/local/bin/python3", "-I", f"/{script}.py"]
c["process"]["terminal"] = False
c["root"]["readonly"] = True
json.dump(c, open(f"{work}/bundle/config.json", "w"))
PY
  ( cd "$work/bundle" && runsc --rootless --network=none --ignore-cgroups \
      run "gv-$1" )
}

echo "## Inside gVisor (--network=none, read-only rootfs, no host mounts)"
for s in audit_hook_bypass dns_vs_rawip home_escape; do
  echo "### $s"; run_in_gvisor "$s" || true
done

# The same scripts under Docker: default runtime (runc) against the gVisor
# runtime (runsc), every other option equal, so only the runtime differs.
# runsc must be registered as a Docker runtime (runsc install, daemon
# restart); that needs root, which is why the post's rootless form does not
# use it. The script is piped on stdin, so nothing is mounted in.
echo "## Docker: default runtime (runc) vs --runtime=runsc, same scripts"
for rt in runc runsc; do
  opt=(); [ "$rt" = runsc ] && opt=(--runtime=runsc)
  echo "kernel $rt $(docker run --rm "${opt[@]}" "$PYTHON_IMAGE" uname -sr)"
  for s in audit_hook_bypass dns_vs_rawip home_escape; do
    echo "### $rt $s"
    docker run --rm -i "${opt[@]}" "$PYTHON_IMAGE" python3 -I - <"$here/$s.py" || true
  done
done

echo "## Cost: docker run python -c pass, 5 runs each (seconds)"
for rt in runc runsc; do
  opt=(); [ "$rt" = runsc ] && opt=(--runtime=runsc)
  for _ in 1 2 3 4 5; do
    t0=$(date +%s.%N)
    docker run --rm "${opt[@]}" "$PYTHON_IMAGE" python3 -c pass
    t1=$(date +%s.%N)
    awk "BEGIN{printf \"cost $rt %.3f\n\", $t1 - $t0}"
  done
done
