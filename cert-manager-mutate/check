#!/usr/bin/env bash
# Verifies the latest signed kadet-hub index and the generator pinned in
# inventory/classes/generators.yml, fetches it by digest, fetches the
# cert-manager and trust-manager charts through Kapitan's helm dependency
# and compiles. Fails unless the mutated output carries the init container
# of cert-manager#6071 and the webhook issuer of trust-manager#778, then
# deploys it with internal-ca.yaml and bundle.yaml to a new kind cluster
# and runs tests/ (EX-11). Set KEEP=1 to keep the cluster.
# Needs gh (authenticated), jq, oras, uv, helm, kind, kubectl, chainsaw,
# openssl, docker.
set -euo pipefail
cd "$(dirname "$0")"
id=https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main
tmp=$(mktemp -d)
cluster=cert-manager-mutate
export KUBECONFIG=$tmp/kubeconfig  # kind and kubectl leave the caller's kubeconfig alone
cleanup() {
  kill "${watcher:-}" 2>/dev/null || true
  rm -rf -- "$tmp"
  [[ ${KEEP:-} == 1 ]] || kind delete cluster --name "$cluster" >/dev/null 2>&1 || true
}
trap cleanup EXIT
rm -rf lib compiled charts

# EX-4: the index signature, then each generator's digest and attestation.
gh release download --repo kadet-hub/registry --pattern 'index.json*' -D "$tmp"
gh attestation verify "$tmp/index.json" --bundle "$tmp/index.json.sigstore.json" \
  --owner kadet-hub --cert-identity "$id" >/dev/null
serial=$(jq -e .serial "$tmp/index.json")
min=$(sed -n 's/^index_serial: //p' .kapitan-sandbox.yaml)
if ((serial < min)); then
  echo "index serial $serial is lower than index_serial $min" >&2
  exit 1
fi
echo "index serial $serial verified"
while read -r name version digest; do
  want=$(jq -er --arg n "$name" --arg v "$version" \
    '.generators[$n][$v] | select(.yanked == null) | .digest' "$tmp/index.json") || {
    echo "$name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  if [[ $want != "$digest" ]]; then
    echo "$name $version: index has $want, inventory pins $digest" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/$name" "ghcr.io/kadet-hub/$name@$digest" >/dev/null
  mkdir -p "lib/$name"
  tar -xf "$tmp/$name/$name.tar" -C "lib/$name" --no-same-owner
  echo "$name $version verified and unpacked"
done < <(sed -nE 's|^ *source: ghcr\.io/kadet-hub/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' \
  inventory/classes/generators.yml)

run() { # command and arguments, in Kapitan's environment
  uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4 "$@"
}
# EX-4: --fetch on target helm, which depends on the charts only; helm checks
# the digest of each OCI artifact against the pinned one.
run kapitan compile --inventory-backend reclass-rs --fetch -t helm >/dev/null
run kapitan compile --inventory-backend reclass-rs

# EX-11: the fixes, and the diff against the plain render with both sides
# loaded and dumped again, so that mutate's reformatting does not show.
run python3 - compiled "$tmp/diff" <<'EOF'
import pathlib, sys, yaml
compiled, out = (pathlib.Path(p) for p in sys.argv[1:])
roots = {chart: {"helm": compiled / "helm" / chart, "mutate": compiled / chart / chart}
         for chart in ("cert-manager", "trust-manager")}
for sides in roots.values():
    for side, root in sides.items():
        for f in root.rglob("*.yaml"):
            docs = [d for d in yaml.safe_load_all(f.read_text()) if d]
            dst = out / side / f.relative_to(root)
            dst.parent.mkdir(parents=True, exist_ok=True)
            dst.write_text(yaml.safe_dump_all(docs, sort_keys=True) if docs else f.read_text())
def objects(chart, side, kind):
    return [d for f in sorted(roots[chart][side].rglob("*.yaml"))
            for d in yaml.safe_load_all(f.read_text()) if d and d["kind"] == kind]
init = yaml.safe_load(pathlib.Path("inventory/targets/cert-manager.yml").read_text())[
    "parameters"]["mutations"]["init-containers"]["json6902"][0]["value"]
def inits(side):
    return {d["metadata"]["name"]: d["spec"]["template"]["spec"].get("initContainers")
            for d in objects("cert-manager", side, "Deployment")}
def refs(side):
    return [d["spec"]["issuerRef"] for d in objects("trust-manager", side, "Certificate")]
checks = {
    # The chart renders no init container, so add creates the list.
    "init-containers": all(v is None for v in inits("helm").values()) and inits("mutate") == {
        "cert-manager": init, "cert-manager-cainjector": None, "cert-manager-webhook": None},
    "no-selfsigned-issuer": [d["spec"] for d in objects("trust-manager", "helm", "Issuer")] == [{"selfSigned": {}}]
        and objects("trust-manager", "mutate", "Issuer") == [],
    "webhook-issuer": refs("helm") == [{"name": "trust-manager", "kind": "Issuer", "group": "cert-manager.io"}]
        and refs("mutate") == [{"name": "internal-ca", "kind": "ClusterIssuer", "group": "cert-manager.io"}],
}
for name, ok in checks.items():
    print(f"EX-11: {name}: {'patched' if ok else 'NOT patched'}")
sys.exit(not all(checks.values()))
EOF
status=0
(cd "$tmp/diff" && diff -ru helm mutate) || status=$?
((status == 1)) || { echo "EX-11: no difference between the helm and the mutated render" >&2; exit 1; }

# EX-6: what a broken or not ready pod leaves to read.
describe_pods() { # namespace pod...
  local ns=$1 pod
  shift
  for pod; do
    kubectl -n "$ns" describe pod "$pod" >&2 || true
    kubectl -n "$ns" logs "$pod" --all-containers --previous --tail=50 >&2 ||
      kubectl -n "$ns" logs "$pod" --all-containers --tail=50 >&2 || true
  done
}
# EX-6: stop the installs or Chainsaw as soon as a pod is broken.
watch_pods() {
  local bad now seen=''
  while sleep 10; do
    bad=$(kubectl get pods -A -o json | jq -r '.items[]
      | select([.status.initContainerStatuses[]?, .status.containerStatuses[]?] | any(
          .restartCount > 3 or (.state.waiting.reason | IN("CrashLoopBackOff", "ImagePullBackOff",
            "CreateContainerConfigError", "InvalidImageName"))))
      | "\(.metadata.namespace) \(.metadata.name)"') || continue
    # EX-6: broken on two polls in a row; Argo CD's server briefly waits for a Secret.
    now=$bad
    bad=$(comm -12 <(sort <<<"$seen") <(sort <<<"$now"))
    seen=$now
    [[ -n $bad ]] || continue
    echo "EX-6: broken pods, stopping the check" >&2
    while read -r ns pod; do
      describe_pods "$ns" "$pod"
    done <<<"$bad"
    pkill -P $$  # check's children: the command it waits for and this watch
    return
  done
}
# EX-6: a kubectl rollout status or wait that prints the namespace on a timeout.
install_wait() { # namespace kubectl-arguments
  local ns=$1 s
  shift
  kubectl -n "$ns" "$@" && return
  s=$?
  kubectl -n "$ns" get events --sort-by=.lastTimestamp >&2 || true
  kubectl -n "$ns" get pods -o wide >&2 || true
  # shellcheck disable=SC2046 # one pod name per word
  describe_pods "$ns" $(kubectl -n "$ns" get pods -o json | jq -r '.items[]
    | select(.status.phase != "Succeeded" and (any(.status.conditions[]?;
        .type == "Ready" and .status == "True") | not)) | .metadata.name')
  return "$s"
}
# EX-6: a webhook can refuse connections for a few seconds after its rollout
# reports done; repeat the (idempotent) apply until the API server accepts it.
apply() { # kubectl apply arguments
  local i
  for i in $(seq 30); do
    kubectl apply "$@" && return
    ((i < 30)) && sleep 2
  done
  return 1
}

# The node image of the workflow's kind release; Renovate updates both together.
# renovate: datasource=docker depName=kindest/node
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
kind create cluster --name "$cluster" --wait 120s --image "$KIND_NODE_IMAGE"
watch_pods &
watcher=$!
kubectl create namespace cert-manager >/dev/null

# EX-11: cert-manager server-side, because three of its CRDs exceed the
# annotation limit of a client-side apply. cert-manager's webhook admits the
# Certificates of internal-ca.yaml and trust-manager, trust-manager's the
# Bundle.
apply --server-side -R -f compiled/cert-manager/cert-manager >/dev/null
install_wait cert-manager wait --for=condition=Available deploy --all --timeout=300s >/dev/null
apply -f internal-ca.yaml
apply -R -f compiled/trust-manager/trust-manager >/dev/null
install_wait cert-manager rollout status deploy/trust-manager --timeout=300s
apply -f bundle.yaml

# EX-11: the init container, the webhook certificate and the Bundle.
chainsaw test --test-dir tests --no-color &
pid=$!
status=0
wait "$pid" || status=$?
((status == 0)) || exit "$status"
echo "cert-manager-mutate: mutated output deployed and checked"
