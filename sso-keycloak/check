#!/usr/bin/env bash
# Single sign-on with Keycloak for Gitea, Open WebUI, Miniflux, Mattermost
# and Synapse, from published recipes and one Kapitan inventory (EX-32).
# Verifies the latest signed index, the recipes pinned in
# fetch/targets/recipes.yml, the recipes they include and the generators
# they pin, pulls all of them by digest, compiles the targets and deploys
# them to a new kind cluster with the Chainsaw test in tests/ (EX-12). Exits
# 0 only if tests/login.py, in a headless Chromium, logs in to each app
# through Keycloak as the realm's user, a wrong password gets no session,
# Gitea, Open WebUI and Synapse turn away a user outside their group, and
# Miniflux pointed at Keycloak's in-cluster name fails on the issuer. Set
# KEEP=1 to keep the cluster.
# Needs gh (authenticated), jq, oras, uv, kind, kubectl, chainsaw, certutil,
# openssl, docker.
set -euo pipefail
cd "$(dirname "$0")"
id=https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main
min_serial=129
tmp=$(mktemp -d)
cluster=sso-keycloak
export KUBECONFIG=$tmp/kubeconfig # kind and kubectl leave the caller's kubeconfig alone
cleanup() {
  kill "${watcher:-}" 2>/dev/null || true
  rm -rf -- "$tmp"
  [[ ${KEEP:-} == 1 ]] || kind delete cluster --name "$cluster" >/dev/null 2>&1 || true
}
trap cleanup EXIT
rm -rf lib compiled inventory/classes/recipes
py=(uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4)

# EX-4: index signature, digests and attestations, then pull by digest, as
# "Verifying a recipe by hand" in the registry's docs/consumers.md does it.
gh release download --repo kadet-hub/registry --pattern 'index.json*' -D "$tmp"
gh attestation verify "$tmp/index.json" --bundle "$tmp/index.json.sigstore.json" \
  --owner kadet-hub --cert-identity "$id" >/dev/null
serial=$(jq -e .serial "$tmp/index.json")
if ((serial < min_serial)); then
  echo "index serial $serial is lower than $min_serial" >&2
  exit 1
fi
echo "index serial $serial verified"

# The pinned recipes, then the recipes their records list under includes, at
# the listed version and digest, as the consumer workflow adds them. All of
# them share inventory/classes/recipes/, so one name at two digests fails.
mapfile -t queue < <(sed -nE 's|^ *source: ghcr\.io/kadet-hub/recipes/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' \
  fetch/targets/recipes.yml)
declare -A wanted
for ((i = 0; i < ${#queue[@]}; i++)); do
  read -r name version digest <<<"${queue[i]}"
  if [[ -n ${wanted[$name]:-} ]]; then
    [[ ${wanted[$name]} == "$version $digest" ]] || {
      echo "recipe $name is wanted as ${wanted[$name]} and as $version $digest" >&2
      exit 1
    }
    continue
  fi
  wanted[$name]="$version $digest"
  record=$(jq -ec --arg n "$name" --arg v "$version" \
    '.recipes[$n][$v] | select(.yanked == null)' "$tmp/index.json") || {
    echo "recipe $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  want=$(jq -r .digest <<<"$record")
  if [[ $want != "$digest" ]]; then
    echo "recipe $name $version: index has $want, the pin or include names $digest" >&2
    exit 1
  fi
  mapfile -t -O "${#queue[@]}" queue < <(jq -r '.includes[] | "\(.name) \(.version) \(.digest)"' <<<"$record")
  gh attestation verify "oci://ghcr.io/kadet-hub/recipes/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/recipes/$name" "ghcr.io/kadet-hub/recipes/$name@$digest" >/dev/null
  mkdir -p "inventory/classes/recipes/$name"
  tar -xf "$tmp/recipes/$name/$name.tar" -C "inventory/classes/recipes/$name" --no-same-owner
  echo "recipe $name $version verified and unpacked"
done
if ((${#wanted[@]} != 12)); then
  echo "expected 12 recipes, found ${!wanted[*]}" >&2
  exit 1
fi

# The generators the recipes pin, which Kapitan would otherwise fetch
# unverified. They share lib/, so one name at two digests fails.
generators=$(cat inventory/classes/recipes/*/*.yml |
  sed -nE 's|^ *source: ghcr\.io/kadet-hub/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' | sort -u)
[[ -n $generators ]] || { echo "the recipes pin no generator" >&2; exit 1; }
twice=$(cut -d' ' -f1 <<<"$generators" | uniq -d)
[[ -z $twice ]] || { echo "generators pinned at two digests: $twice" >&2; exit 1; }
while read -r name version digest; do
  want=$(jq -er --arg n "$name" --arg v "$version" \
    '.generators[$n][$v] | select(.yanked == null) | .digest' "$tmp/index.json") || {
    echo "generator $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  if [[ $want != "$digest" ]]; then
    echo "generator $name $version: index has $want, a recipe pins $digest" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/generators/$name" "ghcr.io/kadet-hub/$name@$digest" >/dev/null
  mkdir -p "lib/$name"
  tar -xf "$tmp/generators/$name/$name.tar" -C "lib/$name" --no-same-owner
  echo "generator $name $version verified and unpacked"
done <<<"$generators"

# The CA that signs Keycloak's certificate and Synapse's, written to the refs
# the targets read, as a reader does once with the backend of the
# repository. The other refs get random values in the first compile, the
# second writes them all into the Secrets.
"${py[@]}" kapitan inventory -t keycloak -p sso -F >"$tmp/sso"
sso() { sed -n "s|^$1: ||p" "$tmp/sso"; }
matrix=$(sso clients.matrix-synapse.url)
name=${matrix#https://} && name=${name%:*}
openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 2 \
  -subj '/CN=sso-keycloak example CA' -addext basicConstraints=critical,CA:TRUE \
  -addext keyUsage=critical,keyCertSign,cRLSign -keyout "$tmp/ca.key" -out "$tmp/ca.crt" 2>/dev/null
openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -subj "/CN=$name" \
  -keyout "$tmp/tls.key" 2>/dev/null |
  openssl x509 -req -CA "$tmp/ca.crt" -CAkey "$tmp/ca.key" -days 2 \
    -extfile <(echo "subjectAltName=DNS:$name") -out "$tmp/tls.crt" 2>/dev/null
for ref in sso/ca.crt sso/ca.key matrix-synapse/tls.crt matrix-synapse/tls.key; do
  "${py[@]}" kapitan refs --refs-path "$tmp/refs" --write "base64:$ref" -f "$tmp/${ref#*/}" >/dev/null
done
compile() {
  "${py[@]}" kapitan compile --refs-path "$tmp/refs" "$@" >"$tmp/compile.log" 2>&1 ||
    { cat "$tmp/compile.log" >&2; exit 1; }
}
# One target at a time: keycloak and each app read the client secret the
# first compile creates, and a parallel compile can read its file empty.
compile --parallelism 1
compile --reveal
reveal() { "${py[@]}" kapitan refs --refs-path "$tmp/refs" --reveal --tag "?{base64:$1}"; }
echo "compiled $(find compiled -type f | wc -l) files"

# EX-32a: a client's URL is set in the class sso only. Changing it in a copy
# changes the redirect URI that Keycloak imports and the URL that Gitea runs
# at, and nothing else. Compiled without --reveal, at the same refs.
git=$(sso clients.gitea.url)
moved=http://code.example.test
mkdir "$tmp/copy"
cp -r .kapitan inventory lib "$tmp/copy/"
(
  cd "$tmp/copy"
  compile -t keycloak gitea
  mv compiled before
  sed -i "s|^        url: $git\$|        url: $moved|" inventory/classes/sso.yml
  compile -t keycloak gitea
  diff -r -U0 before compiled || (($? == 1))
) >"$tmp/moved.diff"
files=$(sed -nE 's|^\+\+\+ compiled/([^\t]+).*|\1|p' "$tmp/moved.diff" | sort | tr '\n' ' ')
removed=$(grep -E '^-[^-]' "$tmp/moved.diff" | grep -cF "$git/") || true
added=$(grep -E '^\+[^+]' "$tmp/moved.diff" | grep -cF "$moved/") || true
lines=$(grep -cE '^[-+]([^-+]|$)' "$tmp/moved.diff") || true
if [[ $files != "gitea/manifests/gitea/gitea-deploy.yml keycloak/manifests/keycloak/home-keycloakrealmimport.yml " ||
  $removed != 2 || $added != 2 || $lines != 4 ]]; then
  cat "$tmp/moved.diff" >&2
  echo "EX-32a: moving Gitea to $moved changed more or less than its redirect URI and ROOT_URL" >&2
  exit 1
fi
echo "Gitea moved to $moved in the class sso:"
grep -E '^(\+\+\+ |[-+][^-+])' "$tmp/moved.diff" | sed -E 's|^\+\+\+ compiled/([^\t]+).*|\1|'

# EX-6: what a broken pod leaves to read.
describe_pods() { # namespace pod...
  local ns=$1 pod
  shift
  for pod; do
    kubectl -n "$ns" describe pod "$pod" >&2 || true
    kubectl -n "$ns" logs "$pod" --all-containers --previous --tail=50 >&2 ||
      kubectl -n "$ns" logs "$pod" --all-containers --tail=50 >&2 || true
  done
}
# EX-6: stop Chainsaw or the logins as soon as a pod is broken.
watch_pods() {
  local bad now seen=''
  while sleep 10; do
    bad=$(kubectl get pods -A -o json | jq -r '.items[]
      | select([.status.initContainerStatuses[]?, .status.containerStatuses[]?] | any(
          .restartCount > 3 or (.state.waiting.reason | IN("CrashLoopBackOff", "ImagePullBackOff",
            "CreateContainerConfigError", "InvalidImageName"))))
      | "\(.metadata.namespace) \(.metadata.name)"') || continue
    now=$bad
    bad=$(comm -12 <(sort <<<"$seen") <(sort <<<"$now"))
    seen=$now
    [[ -n $bad ]] || continue
    echo "EX-6: broken pods, stopping the check" >&2
    while read -r ns pod; do
      describe_pods "$ns" "$pod"
    done <<<"$bad"
    pkill -P $$ # check's children: the command it waits for and this watch
    return
  done
}

# The node image of the workflow's kind release; Renovate updates both together.
# renovate: datasource=docker depName=kindest/node
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
kind create cluster --name "$cluster" --wait 120s --image "$KIND_NODE_IMAGE"
watch_pods &
watcher=$!
chainsaw test --test-dir tests --no-color --set "host=$(sso host)" &
pid=$!
status=0
wait "$pid" || status=$?
((status == 0)) || exit "$status"

# EX-32: the logins run in the Chromium of the Playwright image, the build
# that the Playwright package of the same version drives. Renovate moves
# both in one pull request.
# renovate: datasource=docker depName=mcr.microsoft.com/playwright/python
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright/python:v1.64.1-noble@sha256:330d401ae23c905896a0c26c66c36fc971b621519e7b11b435a8328d7bf6e031
c=$(docker create "$PLAYWRIGHT_IMAGE")
docker cp -q "$c:/ms-playwright" "$tmp/"
docker rm "$c" >/dev/null
reveal sso/ca.crt >"$tmp/ca.pem"
password_alice=$(reveal sso/alice-password)
password_bob=$(reveal sso/bob-password)
PASSWORD_ALICE=$password_alice PASSWORD_BOB=$password_bob PLAYWRIGHT_BROWSERS_PATH=$tmp/ms-playwright \
  uv run --quiet --python 3.13 --with playwright==1.64.1 python -I tests/login.py "$tmp/ca.pem" "$tmp/sso"
echo "sso-keycloak: single sign-on through Keycloak for Gitea, Open WebUI, Miniflux, Mattermost and Synapse passed"
