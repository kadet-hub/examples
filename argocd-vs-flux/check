#!/usr/bin/env bash
# Usage: check <argocd|flux>
#
# Verifies the latest signed kadet-hub index and the generators pinned in
# inventory/classes/generators.yml, fetches them by digest, compiles the app
# and the delivery targets, creates a kind cluster with a Git server, pushes
# the compiled app to it, installs Argo CD or Flux from its pinned release
# manifest, applies the tool's compiled target and runs tests/<tool> (EX-7,
# EX-8). Prints the tool's install footprint. Set KEEP=1 to keep the cluster.
# Needs gh (authenticated), jq, oras, uv, kubeconform, kind, kubectl, chainsaw,
# openssl, docker.
set -euo pipefail
cd "$(dirname "$0")"
tool=${1:?usage: check <argocd|flux>}
[[ $tool == argocd || $tool == flux ]] || { echo "usage: check <argocd|flux>" >&2; exit 1; }
id=https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main
tmp=$(mktemp -d)
cluster=gitops-$tool
export KUBECONFIG=$tmp/kubeconfig  # kind and kubectl leave the caller's kubeconfig alone
cleanup() {
  rm -rf -- "$tmp"
  [[ ${KEEP:-} == 1 ]] || kind delete cluster --name "$cluster" >/dev/null 2>&1 || true
}
trap cleanup EXIT
rm -rf lib compiled

# EX-4: the index signature, then each generator's digest and attestation.
gh release download --repo kadet-hub/registry --pattern 'index.json*' -D "$tmp"
gh attestation verify "$tmp/index.json" --bundle "$tmp/index.json.sigstore.json" \
  --owner kadet-hub --cert-identity "$id" >/dev/null
serial=$(jq -e .serial "$tmp/index.json")
min=$(sed -n 's/^index_serial: //p' .kapitan-sandbox.yaml)
if ((serial < min)); then
  echo "index serial $serial is lower than index_serial $min" >&2
  exit 1
fi
echo "index serial $serial verified"
while read -r name version digest; do
  want=$(jq -er --arg n "$name" --arg v "$version" \
    '.generators[$n][$v] | select(.yanked == null) | .digest' "$tmp/index.json") || {
    echo "$name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  if [[ $want != "$digest" ]]; then
    echo "$name $version: index has $want, inventory pins $digest" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/$name" "ghcr.io/kadet-hub/$name@$digest" >/dev/null
  mkdir -p "lib/$name"
  tar -xf "$tmp/$name/$name.tar" -C "lib/$name" --no-same-owner
  echo "$name $version verified and unpacked"
done < <(sed -nE 's|^ *source: ghcr\.io/kadet-hub/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' \
  inventory/classes/generators.yml)

uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4 \
  kapitan compile --inventory-backend reclass-rs
a=()
for g in lib/*; do
  a+=(-schema-location "$g/schemas/{{.Group}}/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json")
done
kubeconform -strict -summary "${a[@]}" \
  -schema-location 'lib/kubernetes/schemas/core/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json' compiled/

# The node image kind v0.33.0 was built with.
kind create cluster --name "$cluster" --wait 120s \
  --image kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

# EX-7: the compiled app as one commit on main of the in-cluster Git server.
kubectl apply -f git-server.yaml >/dev/null
kubectl -n git rollout status deploy/gitea --timeout=300s
pass=$(openssl rand -hex 16)
kubectl -n git exec deploy/gitea -- gitea admin user create --admin --username kadet \
  --password "$pass" --email kadet@example.com --must-change-password=false >/dev/null
# shellcheck disable=SC2016 # $1 expands in the pod's shell
revision=$(tar -C compiled -cf - web | kubectl -n git exec -i deploy/gitea -- sh -euc '
  mkdir /tmp/app && cd /tmp/app && tar -xf -
  git init -q -b main && git add .
  git -c user.name=check -c user.email=check@example.com commit -qm app
  git push -q "http://kadet:$1@localhost:3000/kadet/app.git" main
  git rev-parse HEAD' sh "$pass")
echo "pushed $revision"
echo "revision: $revision" >"$tmp/values.yaml"

# EX-7: the tool from its pinned release manifest.
manifest() { # url sha256 namespace
  curl -fsSL -o "$tmp/m.yaml" "$1"
  echo "$2  $tmp/m.yaml" | sha256sum -c --quiet
  kubectl apply -n "$3" --server-side --force-conflicts -f "$tmp/m.yaml" >/dev/null
}
installed=$SECONDS
case $tool in
  argocd)
    ns=argocd
    kubectl create namespace argocd >/dev/null
    manifest https://raw.githubusercontent.com/argoproj/argo-cd/v3.5.5/manifests/install.yaml \
      90dc9094bf4c5964afd9c0e35d735e1c2fcbbda4f8e36799c092d9864ed65f50 argocd
    kubectl -n argocd rollout status statefulset/argocd-application-controller --timeout=300s
    ;;
  flux)
    ns=flux-system
    manifest https://github.com/fluxcd/flux2/releases/download/v2.9.6/install.yaml \
      9c1fda7e401429531ed1478f67ba06b3edff6513b75da7ee47bde9f1c4d4251c flux-system
    ;;
esac
kubectl -n "$ns" wait --for=condition=Available deploy --all --timeout=300s >/dev/null
echo "$tool installed and available after $((SECONDS - installed))s:" \
  "$(grep -c '^kind: CustomResourceDefinition' "$tmp/m.yaml") CRDs," \
  "$(kubectl -n "$ns" get pods --no-headers | wc -l) pods, images:"
kubectl -n "$ns" get pods -o json | jq -r '[.items[].spec.containers[].image] | unique[]'
kubectl apply -R -f "compiled/$tool"

# EX-6: stop Chainsaw as soon as a pod is broken instead of at the assert
# timeout; Chainsaw cannot run a watch beside an assert within one test.
watch_pods() { # chainsaw-pid
  local bad
  while sleep 10; do
    bad=$(kubectl get pods -A -o json | jq -r '.items[]
      | select([.status.initContainerStatuses[]?, .status.containerStatuses[]?] | any(
          .restartCount > 3 or (.state.waiting.reason | IN("CrashLoopBackOff", "ImagePullBackOff",
            "CreateContainerConfigError", "InvalidImageName"))))
      | "\(.metadata.namespace) \(.metadata.name)"') || continue
    [[ -n $bad ]] || continue
    echo "EX-6: broken pods, stopping the check" >&2
    while read -r ns pod; do
      kubectl -n "$ns" describe pod "$pod" >&2 || true
      kubectl -n "$ns" logs "$pod" --all-containers --previous --tail=50 >&2 ||
        kubectl -n "$ns" logs "$pod" --all-containers --tail=50 >&2 || true
    done <<<"$bad"
    kill "$1"
    return
  done
}
# EX-7, EX-8: sync state, the deployed revision, the app and drift.
chainsaw test --test-dir "tests/$tool" --values "$tmp/values.yaml" --no-color &
pid=$!
watch_pods "$pid" &
watcher=$!
status=0
wait "$pid" || status=$?
kill "$watcher" 2>/dev/null || true
((status == 0)) || exit "$status"
kubectl get --raw "/api/v1/nodes/$cluster-control-plane/proxy/stats/summary" | jq -r --arg ns "$ns" \
  '[.pods[] | select(.podRef.namespace == $ns) | .memory.workingSetBytes] | add / 1048576 | floor
    | "\($ns) pods memory working set: \(.) MiB"'
echo "$tool: deployed and checked"
