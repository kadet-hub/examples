#!/usr/bin/env bash
# Checks the post's claim: every manifest passes kubeconform -strict against
# the Kubernetes 1.37.1 schemas and schemas generated from the CRDs, and
# ./dry-run accepts the four valid documents and rejects the five broken ones.
# Needs kubeconform, uv and curl, plus what ./dry-run needs.
set -euo pipefail
cd "$(dirname "$0")"
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT

# kubeconform's own converter; no published checksum, sha256 computed locally.
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0
OPENAPI2JSONSCHEMA_SHA256=d145babfbb765004030764e1b4e518bfb7a4bd7f111691a08fa57983b81881f3
curl -fsSLo "$tmp/openapi2jsonschema.py" \
  "https://raw.githubusercontent.com/yannh/kubeconform/$KUBECONFORM_VERSION/scripts/openapi2jsonschema.py"
echo "$OPENAPI2JSONSCHEMA_SHA256  $tmp/openapi2jsonschema.py" |
  sha256sum -c --quiet -
mkdir "$tmp/schemas"
(cd "$tmp/schemas" && uv run --quiet --no-project --with pyyaml==6.0.3 \
  python -I ../openapi2jsonschema.py "$OLDPWD"/crds/*.yaml >/dev/null)
kubeconform -strict -summary -kubernetes-version 1.37.1 -schema-location default \
  -schema-location "$tmp/schemas/{{.ResourceKind}}_{{.ResourceAPIVersion}}.json" manifests/

rc=0
./dry-run crds manifests >"$tmp/out" 2>&1 || rc=$?
cat "$tmp/out"
if ((rc != 1)); then
  echo "dry-run exited $rc, want 1" >&2
  exit 1
fi
while IFS= read -r want; do
  grep -qF -- "$want" "$tmp/out" || { echo "missing: $want" >&2; exit 1; }
done <<'EOF'
The Gateway "internal" is invalid
The HTTPRoute "web-redirect" is invalid
The HTTPRoute "web-slow" is invalid
The Deployment "worker" is invalid
The ConfigMap "Web_Settings" is invalid
gateway.gateway.networking.k8s.io/public created (server dry run)
httproute.gateway.networking.k8s.io/web created (server dry run)
deployment.apps/web created (server dry run)
service/web created (server dry run)
EOF
if (($(grep -c 'is invalid\|created (server dry run)' "$tmp/out") != 9)); then
  echo "want exactly 9 results" >&2
  exit 1
fi
