#!/usr/bin/env bash
# One inventory, three environments, two clusters (EX-28 to EX-28c).
# Verifies the latest signed index, the recipe pinned in
# fetch/targets/recipes.yml and the generator it pins, and pulls them by
# digest. Compiles the targets dev, stage and prod. Exits 0 only if
# - prod differs from stage in the fields of guard-allowed.txt alone,
# - in a copy of the project, a value set in env/dev.yml changes dev's
#   output alone, set in env/stage.yml stage's alone, which the guard refuses,
#   and set in env/prod.yml prod's alone, which the guard accepts, and moving
#   it from the three env classes into common.yml changes no compiled file,
# - deployed to the kind clusters the inventory names, each target runs with
#   the cluster, namespace, replicas, memory limit, hostname and storage class
#   of the table below, and no miniflux pod restarted.
# Set KEEP=1 to keep the clusters.
# Needs gh (authenticated), jq, oras, uv, kind, kubectl, curl, docker.
set -euo pipefail
cd "$(dirname "$0")"
id=https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main
min_serial=113
tmp=$(mktemp -d)
export KUBECONFIG=$tmp/kubeconfig # kind and kubectl leave the caller's kubeconfig alone
clusters=(multienv-a multienv-b)
cleanup() {
  kill "${watcher:-}" "${forward:-}" 2>/dev/null || true
  rm -rf -- "$tmp"
  if [[ ${KEEP:-} != 1 ]]; then
    for c in "${clusters[@]}"; do kind delete cluster --name "$c" >/dev/null 2>&1 || true; done
  fi
}
trap cleanup EXIT
rm -rf lib compiled inventory/classes/recipes
started=$SECONDS
py=(uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4)

# What each target must run with (EX-28): cluster, namespace, replicas,
# memory limit, hostname and storage class.
expected='dev multienv-a miniflux-dev 1 128Mi news.dev.example.com standard
stage multienv-a miniflux 2 256Mi news.stage.example.com standard
prod multienv-b miniflux 3 256Mi news.example.com local-retain'

# EX-4: index signature, digests and attestations, then pull by digest, as
# "Verifying a recipe by hand" in the registry's docs/consumers.md does it.
gh release download --repo kadet-hub/registry --pattern 'index.json*' -D "$tmp"
gh attestation verify "$tmp/index.json" --bundle "$tmp/index.json.sigstore.json" \
  --owner kadet-hub --cert-identity "$id" >/dev/null
serial=$(jq -e .serial "$tmp/index.json")
if ((serial < min_serial)); then
  echo "index serial $serial is lower than $min_serial" >&2
  exit 1
fi
echo "index serial $serial verified"

pins=$(sed -nE 's|^ *source: ghcr\.io/kadet-hub/recipes/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' \
  fetch/targets/recipes.yml)
while read -r name version digest; do
  record=$(jq -ec --arg n "$name" --arg v "$version" \
    '.recipes[$n][$v] | select(.yanked == null)' "$tmp/index.json") || {
    echo "recipe $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  want=$(jq -r .digest <<<"$record")
  if [[ $want != "$digest" ]]; then
    echo "recipe $name $version: index has $want, fetch/targets/recipes.yml pins $digest" >&2
    exit 1
  fi
  if jq -e '.includes | length > 0' <<<"$record" >/dev/null; then
    echo "recipe $name $version includes other recipes, which fetch/targets/recipes.yml does not pin" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/recipes/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/recipes/$name" "ghcr.io/kadet-hub/recipes/$name@$digest" >/dev/null
  mkdir -p "inventory/classes/recipes/$name"
  tar -xf "$tmp/recipes/$name/$name.tar" -C "inventory/classes/recipes/$name" --no-same-owner
  echo "recipe $name $version verified and unpacked"
done <<<"$pins"
if (($(wc -l <<<"$pins") != 1)); then
  echo "expected 1 recipe in fetch/targets/recipes.yml, found $(wc -l <<<"$pins")" >&2
  exit 1
fi
# The generators the recipe pins, which Kapitan would otherwise fetch unverified.
generators=$(cat inventory/classes/recipes/*/*.yml |
  sed -nE 's|^ *source: ghcr\.io/kadet-hub/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' | sort -u)
[[ -n $generators ]] || { echo "the recipe pins no generator" >&2; exit 1; }
while read -r name version digest; do
  want=$(jq -er --arg n "$name" --arg v "$version" \
    '.generators[$n][$v] | select(.yanked == null) | .digest' "$tmp/index.json") || {
    echo "generator $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  if [[ $want != "$digest" ]]; then
    echo "generator $name $version: index has $want, the recipe pins $digest" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/generators/$name" "ghcr.io/kadet-hub/$name@$digest" >/dev/null
  mkdir -p "lib/$name"
  tar -xf "$tmp/generators/$name/$name.tar" -C "lib/$name" --no-same-owner
  echo "generator $name $version verified and unpacked"
done <<<"$generators"

# The first compile creates the refs with random values in the temporary
# directory. Without --reveal the output holds ref tokens, as it would in Git.
compile() { # directory, kapitan compile arguments
  (cd "$1" && shift && "${py[@]}" kapitan compile --refs-path "$tmp/refs" "$@") >"$tmp/compile.log" 2>&1 ||
    { cat "$tmp/compile.log"; exit 1; }
}
compile .
for t in dev stage prod; do echo "compiled $t: $(find "compiled/$t" -type f | wc -l) files"; done

# EX-28b: prod against stage, before any change.
guard=(python3 "$PWD/guard")
"${py[@]}" "${guard[@]}" compiled/stage compiled/prod guard-allowed.txt

# EX-28a: a value rolled through the env classes in a copy of the project.
# Each step compiles the copy and diffs it against the step before.
mkdir "$tmp/work"
cp -r .kapitan inventory lib "$tmp/work/"
cp -r compiled "$tmp/before"
step() { # description, the targets that must change
  local changed='' t
  compile "$tmp/work"
  for t in dev stage prod; do
    diff -rq "$tmp/before/$t" "$tmp/work/compiled/$t" >/dev/null || changed+="$t "
  done
  changed=${changed% }
  echo "EX-28a: $1 changes ${changed:-no target}"
  (cd "$tmp" && diff -r before work/compiled) || true
  if [[ $changed != "$2" ]]; then
    echo "EX-28a: expected it to change ${2:-no target}" >&2
    exit 1
  fi
  rm -rf "$tmp/before"
  cp -r "$tmp/work/compiled" "$tmp/before"
}
metrics='      env:
        METRICS_COLLECTOR: 1'
echo "$metrics" >>"$tmp/work/inventory/classes/env/dev.yml"
step "METRICS_COLLECTOR in env/dev.yml" dev
echo "$metrics" >>"$tmp/work/inventory/classes/env/stage.yml"
step "METRICS_COLLECTOR in env/stage.yml" stage
if out=$("${py[@]}" "${guard[@]}" "$tmp/work/compiled/stage" "$tmp/work/compiled/prod" guard-allowed.txt 2>&1); then
  echo "$out"
  echo "EX-28b: the guard accepts prod behind stage" >&2
  exit 1
fi
echo "$out"
grep -qF 'NOT ALLOWED: Deployment/miniflux spec.template.spec.containers[miniflux].env[METRICS_COLLECTOR].value' <<<"$out" || {
  echo "EX-28b: the guard refused, but not for METRICS_COLLECTOR" >&2
  exit 1
}
echo "$metrics" >>"$tmp/work/inventory/classes/env/prod.yml"
step "METRICS_COLLECTOR in env/prod.yml" prod
"${py[@]}" "${guard[@]}" "$tmp/work/compiled/stage" "$tmp/work/compiled/prod" guard-allowed.txt
cp inventory/classes/env/*.yml "$tmp/work/inventory/classes/env/"
sed -i 's|^\( *\)BASE_URL: .*$|&\n\1METRICS_COLLECTOR: 1|' "$tmp/work/inventory/classes/common.yml"
step "METRICS_COLLECTOR moved from the env classes to common.yml" ""

# EX-28: the clusters and namespaces come from the inventory.
compile . --reveal
inventory=$("${py[@]}" kapitan inventory --flat 2>/dev/null)
param() { sed -nE "s/^$1\.parameters\.$2: (.+)$/\1/p" <<<"$inventory"; }
while read -r t cluster ns _; do
  got="$(param "$t" cluster.name) $(param "$t" namespace)"
  if [[ $got != "$cluster $ns" ]]; then
    echo "EX-28: the inventory places $t in $got, not in $cluster $ns" >&2
    exit 1
  fi
done <<<"$expected"

# EX-6: what a broken or not ready pod leaves to read.
describe_pods() { # cluster namespace pod...
  local c=$1 ns=$2 pod
  shift 2
  for pod; do
    kubectl --context "kind-$c" -n "$ns" describe pod "$pod" >&2 || true
    kubectl --context "kind-$c" -n "$ns" logs "$pod" --all-containers --previous --tail=50 >&2 ||
      kubectl --context "kind-$c" -n "$ns" logs "$pod" --all-containers --tail=50 >&2 || true
  done
}
# EX-6: stop the rollout status as soon as a pod is broken, in either cluster.
watch_pods() {
  local bad c now seen=''
  while sleep 10; do
    now=$(for c in "${clusters[@]}"; do
      kubectl --context "kind-$c" get pods -A -o json | jq -r --arg c "$c" '.items[]
        | select([.status.initContainerStatuses[]?, .status.containerStatuses[]?] | any(
            .restartCount > 3 or (.state.waiting.reason | IN("CrashLoopBackOff", "ImagePullBackOff",
              "CreateContainerConfigError", "InvalidImageName"))))
        | "\($c) \(.metadata.namespace) \(.metadata.name)"'
    done) || continue
    # EX-6: broken on two polls in a row.
    bad=$(comm -12 <(sort <<<"$seen") <(sort <<<"$now"))
    seen=$now
    [[ -n $bad ]] || continue
    echo "EX-6: broken pods, stopping the check" >&2
    while read -r c ns pod; do
      describe_pods "$c" "$ns" "$pod"
    done <<<"$bad"
    pkill -P $$ # check's children: the command it waits for and this watch
    return
  done
}
# EX-6: a kubectl rollout status that prints the namespace on a timeout.
install_wait() { # cluster namespace kubectl-arguments
  local c=$1 ns=$2 s
  shift 2
  kubectl --context "kind-$c" -n "$ns" "$@" && return
  s=$?
  kubectl --context "kind-$c" -n "$ns" get events --sort-by=.lastTimestamp >&2 || true
  kubectl --context "kind-$c" -n "$ns" get pods -o wide >&2 || true
  # shellcheck disable=SC2046 # one pod name per word
  describe_pods "$c" "$ns" $(kubectl --context "kind-$c" -n "$ns" get pods -o json | jq -r '.items[]
    | select(.status.phase != "Succeeded" and (any(.status.conditions[]?;
        .type == "Ready" and .status == "True") | not)) | .metadata.name')
  return "$s"
}

# The node image of the workflow's kind release; Renovate updates both together.
# renovate: datasource=docker depName=kindest/node
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
for c in "${clusters[@]}"; do
  kind create cluster --name "$c" --wait 120s --image "$KIND_NODE_IMAGE"
done
# kind's StorageClass standard deletes a volume with its claim. The prod
# cluster's class local-retain keeps it.
kubectl --context kind-multienv-b apply -f storage-class.yaml >/dev/null
watch_pods &
watcher=$!

# EX-28: PostgreSQL first, because miniflux exits while it cannot connect.
# Then one miniflux pod alone, as the recipe's README asks: miniflux migrates
# the empty database at start without a lock. The target's replicas follow
# once that pod is ready. The images run as root, so the namespaces enforce
# baseline.
while read -r t cluster ns _; do
  deploying=$SECONDS
  kubectl --context "kind-$cluster" create namespace "$ns" >/dev/null
  kubectl --context "kind-$cluster" label namespace "$ns" pod-security.kubernetes.io/enforce=baseline >/dev/null
  kubectl --context "kind-$cluster" apply -R -f "compiled/$t" -l name=miniflux-db >/dev/null
  install_wait "$cluster" "$ns" rollout status statefulset/miniflux-db --timeout=300s >/dev/null
  kubectl --context "kind-$cluster" apply -R -f "compiled/$t" --dry-run=client -o json |
    jq '(.items[] | select(.kind == "Deployment") | .spec.replicas) = 1' |
    kubectl --context "kind-$cluster" apply -f - >/dev/null
  install_wait "$cluster" "$ns" rollout status deploy/miniflux --timeout=300s >/dev/null
  kubectl --context "kind-$cluster" apply -R -f "compiled/$t" >/dev/null
  install_wait "$cluster" "$ns" rollout status deploy/miniflux --timeout=300s >/dev/null
  echo "deployed $t to $cluster in $((SECONDS - deploying))s"
done <<<"$expected"

# EX-28: what each target runs with. The memory limit is read from the
# cgroup of every miniflux container, the hostname from miniflux's own page
# of API endpoints, which it builds from BASE_URL.
port=18080
while read -r t cluster ns replicas memory hostname class; do
  kc=(kubectl --context "kind-$cluster" -n "$ns")
  ready=$("${kc[@]}" get deploy miniflux -o jsonpath='{.status.readyReplicas}')
  if [[ $ready != "$replicas" ]]; then
    echo "EX-28: $t has $ready ready replicas, not $replicas" >&2
    exit 1
  fi
  limits=$(for pod in $("${kc[@]}" get pods -l name=miniflux -o name); do
    "${kc[@]}" exec "$pod" -c miniflux -- cat /sys/fs/cgroup/memory.max
  done | sort -u)
  if [[ $limits != $((${memory%Mi} * 1048576)) ]]; then
    echo "EX-28: $t's miniflux containers have memory.max $limits, not $memory" >&2
    exit 1
  fi
  pv=$("${kc[@]}" get pvc miniflux-db-miniflux-db-0 -o jsonpath='{.spec.storageClassName} {.spec.volumeName}')
  if [[ ${pv% *} != "$class" ]]; then
    echo "EX-28: $t's database claim has the storage class ${pv% *}, not $class" >&2
    exit 1
  fi
  reclaim=$(kubectl --context "kind-$cluster" get pv "${pv#* }" -o jsonpath='{.spec.persistentVolumeReclaimPolicy}')

  port=$((port + 1))
  password=$("${kc[@]}" get secret miniflux -o jsonpath='{.data.ADMIN_PASSWORD}' | base64 -d)
  "${kc[@]}" port-forward service/miniflux "$port:80" >/dev/null &
  forward=$!
  url=http://127.0.0.1:$port
  for _ in $(seq 30); do curl -fsS "$url/healthcheck" >/dev/null 2>&1 && break; sleep 1; done
  jar=$tmp/$t.cookies
  csrf=$(curl -fsS -c "$jar" -b "$jar" "$url/" | sed -nE 's/.*name="csrf" value="([^"]+)".*/\1/p' | head -1)
  curl -fsS -c "$jar" -b "$jar" -o /dev/null --data-urlencode "csrf=$csrf" \
    --data-urlencode username=admin --data-urlencode "password=$password" "$url/login"
  endpoint=$(curl -fsS -b "$jar" "$url/integrations" |
    sed -nE 's|.*Google Reader API endpoint: <strong>([^<]+)</strong>.*|\1|p')
  kill "$forward"
  if [[ $endpoint != "https://$hostname/" ]]; then
    echo "EX-28: $t's miniflux names its API endpoint '$endpoint', not https://$hostname/" >&2
    exit 1
  fi
  echo "EX-28: $t on $cluster in namespace $ns: ready replicas $ready, memory.max $limits ($memory)," \
    "API endpoint $endpoint, database claim on $class with reclaim policy $reclaim"
done <<<"$expected"
# EX-28c: no miniflux pod restarted.
restarts=$(for c in "${clusters[@]}"; do
  kubectl --context "kind-$c" get pods -A -l name=miniflux -o json | jq -r --arg c "$c" '.items[]
    | "  \($c) \(.metadata.namespace)/\(.metadata.name): restart count \(.status.containerStatuses[0].restartCount)"'
done)
echo "$restarts"
if grep -qv ': restart count 0$' <<<"$restarts"; then
  echo "EX-28c: a miniflux pod restarted" >&2
  exit 1
fi
echo "multi-env: passed in $((SECONDS - started))s"
