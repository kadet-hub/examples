#!/usr/bin/env bash
# Open WebUI with SearXNG as its web search, from the published recipes
# open-webui, ollama, searxng and valkey (EX-17). Verifies the latest signed
# index, the recipes pinned in fetch/targets/recipes.yml, the recipes they
# include and the generators they pin, pulls all of them by digest, compiles
# both targets and deploys
# them to a new kind cluster (EX-12). Exits 0 only if, through Open WebUI's
# API, a web search returns results from SearXNG and fails once SearXNG is
# scaled to zero, and smollm:135m, pulled into Ollama through Open WebUI,
# answers a chat completion. Set KEEP=1 to keep the cluster.
# Needs gh (authenticated), jq, oras, uv, kind, kubectl, curl, docker.
set -euo pipefail
cd "$(dirname "$0")"
id=https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main
min_serial=115
tmp=$(mktemp -d)
cluster=open-webui-searxng
export KUBECONFIG=$tmp/kubeconfig # kind and kubectl leave the caller's kubeconfig alone
cleanup() {
  kill "${watcher:-}" "${forward:-}" 2>/dev/null || true
  rm -rf -- "$tmp"
  [[ ${KEEP:-} == 1 ]] || kind delete cluster --name "$cluster" >/dev/null 2>&1 || true
}
trap cleanup EXIT
rm -rf lib compiled inventory/classes/recipes
py=(uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4)

# EX-4: index signature, digests and attestations, then pull by digest, as
# "Verifying a recipe by hand" in the registry's docs/consumers.md does it.
gh release download --repo kadet-hub/registry --pattern 'index.json*' -D "$tmp"
gh attestation verify "$tmp/index.json" --bundle "$tmp/index.json.sigstore.json" \
  --owner kadet-hub --cert-identity "$id" >/dev/null
serial=$(jq -e .serial "$tmp/index.json")
if ((serial < min_serial)); then
  echo "index serial $serial is lower than $min_serial" >&2
  exit 1
fi
echo "index serial $serial verified"

# The pinned recipes, then the recipes their records list under includes, at
# the listed version and digest, as the consumer workflow adds them. All of
# them share inventory/classes/recipes/, so one name at two digests fails.
mapfile -t queue < <(sed -nE 's|^ *source: ghcr\.io/kadet-hub/recipes/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' \
  fetch/targets/recipes.yml)
declare -A wanted
for ((i = 0; i < ${#queue[@]}; i++)); do
  read -r name version digest <<<"${queue[i]}"
  if [[ -n ${wanted[$name]:-} ]]; then
    [[ ${wanted[$name]} == "$version $digest" ]] || {
      echo "recipe $name is wanted as ${wanted[$name]} and as $version $digest" >&2
      exit 1
    }
    continue
  fi
  wanted[$name]="$version $digest"
  record=$(jq -ec --arg n "$name" --arg v "$version" \
    '.recipes[$n][$v] | select(.yanked == null)' "$tmp/index.json") || {
    echo "recipe $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  want=$(jq -r .digest <<<"$record")
  if [[ $want != "$digest" ]]; then
    echo "recipe $name $version: index has $want, the pin or include names $digest" >&2
    exit 1
  fi
  mapfile -t -O "${#queue[@]}" queue < <(jq -r '.includes[] | "\(.name) \(.version) \(.digest)"' <<<"$record")
  gh attestation verify "oci://ghcr.io/kadet-hub/recipes/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/recipes/$name" "ghcr.io/kadet-hub/recipes/$name@$digest" >/dev/null
  mkdir -p "inventory/classes/recipes/$name"
  tar -xf "$tmp/recipes/$name/$name.tar" -C "inventory/classes/recipes/$name" --no-same-owner
  echo "recipe $name $version verified and unpacked"
done
if ((${#wanted[@]} != 4)); then
  echo "expected 4 recipes, found ${!wanted[*]}" >&2
  exit 1
fi

# The generators the recipes pin, which Kapitan would otherwise fetch unverified.
generators=$(cat inventory/classes/recipes/*/*.yml |
  sed -nE 's|^ *source: ghcr\.io/kadet-hub/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' | sort -u)
[[ -n $generators ]] || { echo "the recipes pin no generator" >&2; exit 1; }
while read -r name version digest; do
  want=$(jq -er --arg n "$name" --arg v "$version" \
    '.generators[$n][$v] | select(.yanked == null) | .digest' "$tmp/index.json") || {
    echo "generator $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  if [[ $want != "$digest" ]]; then
    echo "generator $name $version: index has $want, a recipe pins $digest" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/generators/$name" "ghcr.io/kadet-hub/$name@$digest" >/dev/null
  mkdir -p "lib/$name"
  tar -xf "$tmp/generators/$name/$name.tar" -C "lib/$name" --no-same-owner
  echo "generator $name $version verified and unpacked"
done <<<"$generators"

# The first compile creates the refs with random values in the temporary
# directory, the second writes them into the Secrets.
compile() {
  "${py[@]}" kapitan compile --refs-path "$tmp/refs" "$@" >"$tmp/compile.log" 2>&1 ||
    { cat "$tmp/compile.log"; exit 1; }
}
compile
compile --reveal
echo "compiled $(find compiled/searxng -type f | wc -l) files for searxng, $(find compiled/open-webui -type f | wc -l) for open-webui"

# EX-6: what a broken or not ready pod leaves to read.
describe_pods() { # namespace pod...
  local ns=$1 pod
  shift
  for pod; do
    kubectl -n "$ns" describe pod "$pod" >&2 || true
    kubectl -n "$ns" logs "$pod" --all-containers --previous --tail=50 >&2 ||
      kubectl -n "$ns" logs "$pod" --all-containers --tail=50 >&2 || true
  done
}
# EX-6: stop the rollout status as soon as a pod is broken.
watch_pods() {
  local bad now seen=''
  while sleep 10; do
    bad=$(kubectl get pods -A -o json | jq -r '.items[]
      | select([.status.initContainerStatuses[]?, .status.containerStatuses[]?] | any(
          .restartCount > 3 or (.state.waiting.reason | IN("CrashLoopBackOff", "ImagePullBackOff",
            "CreateContainerConfigError", "InvalidImageName"))))
      | "\(.metadata.namespace) \(.metadata.name)"') || continue
    now=$bad
    bad=$(comm -12 <(sort <<<"$seen") <(sort <<<"$now"))
    seen=$now
    [[ -n $bad ]] || continue
    echo "EX-6: broken pods, stopping the check" >&2
    while read -r ns pod; do
      describe_pods "$ns" "$pod"
    done <<<"$bad"
    pkill -P $$ # check's children: the command it waits for and this watch
    return
  done
}
# EX-6: a kubectl rollout status or wait that prints the namespace on a timeout.
install_wait() { # namespace kubectl-arguments
  local ns=$1 s
  shift
  kubectl -n "$ns" "$@" && return
  s=$?
  kubectl -n "$ns" get events --sort-by=.lastTimestamp >&2 || true
  kubectl -n "$ns" get pods -o wide >&2 || true
  # shellcheck disable=SC2046 # one pod name per word
  describe_pods "$ns" $(kubectl -n "$ns" get pods -o json | jq -r '.items[]
    | select(.status.phase != "Succeeded" and (any(.status.conditions[]?;
        .type == "Ready" and .status == "True") | not)) | .metadata.name')
  return "$s"
}

# EX-12: both targets on kind, each in its namespace at the Pod Security level
# baseline, because SearXNG, Open WebUI and Ollama run as root.
# The node image of the workflow's kind release; Renovate updates both together.
# renovate: datasource=docker depName=kindest/node
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
kind create cluster --name "$cluster" --wait 120s --image "$KIND_NODE_IMAGE"
watch_pods &
watcher=$!
start=$(date +%s)
for ns in searxng open-webui; do
  kubectl create namespace "$ns" >/dev/null
  kubectl label namespace "$ns" pod-security.kubernetes.io/enforce=baseline >/dev/null
  kubectl apply -R -f "compiled/$ns"
done
install_wait searxng rollout status deploy/valkey --timeout=600s
install_wait searxng rollout status statefulset/searxng --timeout=600s
install_wait open-webui rollout status deploy/valkey --timeout=600s
install_wait open-webui rollout status deploy/ollama --timeout=600s
install_wait open-webui rollout status statefulset/open-webui --timeout=600s
ready=$(date +%s)

# searxng 1.0.1 has a readiness probe on /healthz. open-webui 1.0.0 has
# none, so its rollout ends before Open WebUI listens.
searxng=/api/v1/namespaces/searxng/services/searxng:8080/proxy
openwebui=/api/v1/namespaces/open-webui/services/open-webui:80/proxy
for _ in $(seq 150); do
  kubectl get --raw "$openwebui/health" 2>/dev/null | jq -e '.status == true' >/dev/null && break
  sleep 2
done
kubectl get --raw "$openwebui/health" | jq -e '.status == true' >/dev/null
listening=$(date +%s)
echo "deployed in $((ready - start))s, Open WebUI answered /health $((listening - ready))s later"

# Started only now: a port-forward ends at the first connection the pod refuses.
kubectl -n open-webui port-forward service/open-webui 18080:80 >/dev/null &
forward=$!
url=http://127.0.0.1:18080
for _ in $(seq 30); do
  curl -fsS -o /dev/null "$url/health" 2>/dev/null && break
  sleep 1
done

# The first account becomes admin.
token=$(jq -n '{name: "Admin", email: "admin@example.com", password: "Check-Passw0rd"}' |
  curl -fsS --max-time 60 -H 'Content-Type: application/json' -d @- "$url/api/v1/auths/signup" |
  jq -er 'select(.role == "admin") | .token')
api() { # path [curl arguments]: prints the body and, on its own line, the status
  local path=$1
  shift
  curl -sS --max-time 600 -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
    -w '\n%{http_code}' "$@" "$url$path"
}

query=kubernetes
search() { api /api/v1/retrieval/process/web/search -d "$(jq -nc --arg q "$query" '{queries: [$q]}')"; }
# Not part of the claim: the same query sent to SearXNG directly, with the
# results per engine and the engines that did not answer.
engines() {
  kubectl get --raw "$searxng/search?q=$query&format=json" | jq -c '{results: (.results | length),
    engines: ([.results[].engines[]] | group_by(.) | map({(.[0]): length}) | add), unresponsive_engines}' || true
}
t=$(date +%s)
r=$(search)
searched=$(date +%s)
code=${r##*$'\n'}
body=${r%$'\n'*}
if [[ $code != 200 ]] || ! jq -e '.items | length > 0' <<<"$body" >/dev/null; then
  echo "web search for $query: HTTP $code: $body" >&2
  engines >&2
  exit 1
fi
echo "web search for $query in $((searched - t))s: $(jq -r '[.items[].link] | join(" ")' <<<"$body"), $(jq -r .loaded_count <<<"$body") pages loaded"
echo "SearXNG asked directly: $(engines)"

# The same model the open-webui recipe's smoke test pulls, through Open WebUI.
model=smollm:135m
t=$(date +%s)
r=$(api /ollama/api/pull -d "$(jq -nc --arg model "$model" '{$model}')")
# The body streams one JSON object per line and ends with the status success.
if [[ ${r##*$'\n'} != 200 ]] || ! grep . <<<"${r%$'\n'*}" | tail -n 1 | jq -e '.status == "success"' >/dev/null; then
  echo "pull $model: $r" >&2
  exit 1
fi
pulled=$(date +%s)
r=$(api /api/chat/completions -d "$(jq -nc --arg model "$model" \
  '{$model, stream: false, max_tokens: 32, messages: [{role: "user", content: "What is Kubernetes? Answer in one sentence."}]}')")
answer=$(jq -er 'select(.choices[0].message.content | length > 0) | .choices[0].message.content' <<<"${r%$'\n'*}") ||
  { echo "chat completion: $r" >&2; exit 1; }
completed=$(date +%s)
echo "pulled $model in $((pulled - t))s, chat completion in $((completed - pulled))s: $(tr -s '[:space:]' ' ' <<<"$answer")"

# Without SearXNG the same search fails, and Open WebUI logs that it could
# not connect to the host of SEARXNG_QUERY_URL, so the results above came
# from SearXNG.
host=$(sed -nE 's|^ *SEARXNG_QUERY_URL: http://([^/]+)/.*|\1|p' inventory/targets/open-webui.yml)
kubectl -n searxng scale statefulset/searxng --replicas=0 >/dev/null
kubectl -n searxng wait pod/searxng-0 --for=delete --timeout=120s >/dev/null
since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
r=$(search)
code=${r##*$'\n'}
# The log is read whole: grep -q would end a pipe while kubectl still writes,
# and pipefail would then fail the search for a line that is there.
if [[ $code != 400 ]] || ! grep -qF "Cannot connect to host $host" \
  <<<"$(kubectl -n open-webui logs open-webui-0 -c open-webui --since-time="$since")"; then
  echo "web search for $query with SearXNG scaled to zero: HTTP $code: ${r%$'\n'*}" >&2
  exit 1
fi
echo "with SearXNG scaled to zero the web search fails with HTTP $code, and Open WebUI cannot connect to $host"
echo "open-webui-searxng: web search through SearXNG and a chat completion through Ollama passed"
