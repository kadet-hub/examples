#!/usr/bin/env bash
# The same Miniflux on Kubernetes and on a Docker host, from one Kapitan
# inventory (EX-30). Verifies the latest signed index, the recipe pinned in
# fetch/targets/recipes.yml and the generator it pins, and pulls them by
# digest. Compiles the target cluster with the kubernetes generator and the
# target compose with components/compose. Exits 0 only if an image set in the
# shared class changes the image line of both outputs and nothing else, the
# target compose refuses a Kubernetes-only key in the shared class, and
# Miniflux answers its health check, reports the recipe's version and stores
# and lists a category through its API, first in a new kind cluster, then
# under docker compose.
# Set KEEP=1 to keep the cluster and the compose project.
# Needs gh (authenticated), jq, oras, uv, kind, kubectl, curl, docker with
# the compose plugin.
set -euo pipefail
cd "$(dirname "$0")"
id=https://github.com/kadet-hub/registry/.github/workflows/release.yml@refs/heads/main
min_serial=113
tmp=$(mktemp -d)
cluster="compose-miniflux"
compose=(docker compose -p compose-ex-miniflux)
export KUBECONFIG=$tmp/kubeconfig # kind and kubectl leave the caller's kubeconfig alone
cleanup() {
  kill "${watcher:-}" "${forward:-}" 2>/dev/null || true
  rm -rf -- "$tmp"
  [[ ${KEEP:-} == 1 ]] && return
  kind delete cluster --name "$cluster" >/dev/null 2>&1 || true
  "${compose[@]}" down -v >/dev/null 2>&1 || true
}
trap cleanup EXIT
rm -rf lib compiled inventory/classes/recipes
started=$SECONDS
py=(uv run --quiet --python 3.13 --with 'kapitan[omegaconf,reclass-rs]==0.36.3' --with omegaconf==2.4.0.dev4)

# EX-4: index signature, digests and attestations, then pull by digest, as
# "Verifying a recipe by hand" in the registry's docs/consumers.md does it.
gh release download --repo kadet-hub/registry --pattern 'index.json*' -D "$tmp"
gh attestation verify "$tmp/index.json" --bundle "$tmp/index.json.sigstore.json" \
  --owner kadet-hub --cert-identity "$id" >/dev/null
serial=$(jq -e .serial "$tmp/index.json")
if ((serial < min_serial)); then
  echo "index serial $serial is lower than $min_serial" >&2
  exit 1
fi
echo "index serial $serial verified"

pins=$(sed -nE 's|^ *source: ghcr\.io/kadet-hub/recipes/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' \
  fetch/targets/recipes.yml)
while read -r name version digest; do
  record=$(jq -ec --arg n "$name" --arg v "$version" \
    '.recipes[$n][$v] | select(.yanked == null)' "$tmp/index.json") || {
    echo "recipe $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  want=$(jq -r .digest <<<"$record")
  if [[ $want != "$digest" ]]; then
    echo "recipe $name $version: index has $want, fetch/targets/recipes.yml pins $digest" >&2
    exit 1
  fi
  if jq -e '.includes | length > 0' <<<"$record" >/dev/null; then
    echo "recipe $name $version includes other recipes, which fetch/targets/recipes.yml does not pin" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/recipes/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/recipes/$name" "ghcr.io/kadet-hub/recipes/$name@$digest" >/dev/null
  mkdir -p "inventory/classes/recipes/$name"
  tar -xf "$tmp/recipes/$name/$name.tar" -C "inventory/classes/recipes/$name" --no-same-owner
  echo "recipe $name $version verified and unpacked"
done <<<"$pins"
if (($(wc -l <<<"$pins") != 1)); then
  echo "expected 1 recipe in fetch/targets/recipes.yml, found $(wc -l <<<"$pins")" >&2
  exit 1
fi
# The generator the recipe pins, which Kapitan would otherwise fetch unverified.
generators=$(cat inventory/classes/recipes/*/*.yml |
  sed -nE 's|^ *source: ghcr\.io/kadet-hub/([a-z0-9-]+):([^@]+)@(sha256:[0-9a-f]{64})$|\1 \2 \3|p' | sort -u)
[[ -n $generators ]] || { echo "the recipe pins no generator" >&2; exit 1; }
while read -r name version digest; do
  want=$(jq -er --arg n "$name" --arg v "$version" \
    '.generators[$n][$v] | select(.yanked == null) | .digest' "$tmp/index.json") || {
    echo "generator $name $version is missing or yanked in index serial $serial" >&2
    exit 1
  }
  if [[ $want != "$digest" ]]; then
    echo "generator $name $version: index has $want, the recipe pins $digest" >&2
    exit 1
  fi
  gh attestation verify "oci://ghcr.io/kadet-hub/$name@$digest" \
    --owner kadet-hub --cert-identity "$id" >/dev/null
  oras pull -o "$tmp/generators/$name" "ghcr.io/kadet-hub/$name@$digest" >/dev/null
  mkdir -p "lib/$name"
  tar -xf "$tmp/generators/$name/$name.tar" -C "lib/$name" --no-same-owner
  echo "generator $name $version verified and unpacked"
done <<<"$generators"

compile() { # kapitan compile arguments
  "${py[@]}" kapitan compile --refs-path "$tmp/refs" "$@" >"$tmp/compile.log" 2>&1 ||
    { cat "$tmp/compile.log" >&2; return 1; }
}
# The first compile creates the refs with random values. Without --reveal,
# the outputs and their diff hold ref tags, not the passwords.
compile --output-path "$tmp/before"
echo "compiled the targets cluster and compose; compiled/compose/compose.yml without --reveal:"
cat "$tmp/before/compiled/compose/compose.yml"

# EX-30a: an image set in the shared class, here the recipe's with the next
# patch version, changes the image line of both outputs and nothing else.
image=$(sed -nE 's/^ +image: (miniflux\/miniflux:[0-9.]+)@sha256:[0-9a-f]{64}$/\1/p' \
  inventory/classes/recipes/miniflux/miniflux.yml)
[[ -n $image ]] || { echo "EX-30a: no miniflux image with tag and digest in the recipe" >&2; exit 1; }
tag=${image#*:}
next=${image%:*}:${tag%.*}.$((${tag##*.} + 1))
cp -r inventory "$tmp/inventory"
cat >>"$tmp/inventory/classes/miniflux.yml" <<EOF
  components:
    miniflux:
      image: $next
EOF
compile --inventory-path "$tmp/inventory" --output-path "$tmp/after"
echo "EX-30a: the shared class sets image $next; diff of the compiled output:"
# diff exits 1 when the trees differ. The headers lose their timestamps.
(cd "$tmp" && diff -ru before/compiled after/compiled || true) |
  sed -E 's/^((---|\+\+\+) [^\t]+)\t.*/\1/' | tee "$tmp/image.diff"
changed=$(cd "$tmp" && { diff -rq before/compiled after/compiled || true; } |
  sed -E 's|^Files before/compiled/([^ ]+) and .*|\1|' | LC_ALL=C sort | paste -sd ' ')
if [[ $changed != "cluster/manifests/miniflux/miniflux-deploy.yml compose/compose.yml" ]]; then
  echo "EX-30a: expected the Deployment and compose.yml to change, got: ${changed:-nothing}" >&2
  exit 1
fi
# The changed lines without indentation, the old one without its digest.
lines=$(grep -vE '^(---|\+\+\+) ' "$tmp/image.diff" | grep -E '^[-+]' |
  sed -E 's/^([-+]) +/\1/; s/@sha256:[0-9a-f]{64}$//' | LC_ALL=C sort | paste -sd '|')
if [[ $lines != "+image: $next|+image: $next|-image: $image|-image: $image" ]]; then
  echo "EX-30a: the diff changes more than the image line of each output" >&2
  exit 1
fi

# EX-30b: a key that only the cluster has a use for fails the target compose
# when it is in the shared class.
cp -r inventory "$tmp/inventory-pss"
cat >>"$tmp/inventory-pss/classes/miniflux.yml" <<EOF
  components:
    miniflux:
      security_profile: restricted
EOF
if compile --inventory-path "$tmp/inventory-pss" --output-path "$tmp/pss" -t compose 2>/dev/null; then
  echo "EX-30b: the target compose compiled security_profile from the shared class" >&2
  exit 1
fi
refusal="components.miniflux: no Compose mapping for ['security_profile']"
grep -qF "$refusal" "$tmp/compile.log" || { cat "$tmp/compile.log" >&2; exit 1; }
echo "EX-30b: the target compose refuses security_profile in the shared class: $refusal"

compile --reveal -t cluster
echo "compiled the target cluster with --reveal in $((SECONDS - started))s"

# EX-30: Miniflux behind a base URL answers its health check, reports the
# recipe's version and stores and lists a category, logged in as the admin
# the recipe creates with the password of the ref.
admin=$("${py[@]}" kapitan refs --refs-path "$tmp/refs" --reveal --tag '?{base64:miniflux/admin-password}')
smoke() { # runtime base-url
  local runtime=$1 url=$2 version category
  for _ in $(seq 60); do
    [[ $(curl -fsS "$url/healthcheck" 2>/dev/null) == OK ]] && break
    sleep 2
  done
  [[ $(curl -fsS "$url/healthcheck") == OK ]] || {
    echo "EX-30: Miniflux on $runtime does not answer /healthcheck with OK" >&2
    return 1
  }
  version=$(curl -fsS -u "admin:$admin" "$url/v1/version" | jq -er .version)
  if [[ $version != "$tag" ]]; then
    echo "EX-30: Miniflux on $runtime reports version $version, the recipe pins $tag" >&2
    return 1
  fi
  category=$(jq -nc --arg title "check $runtime" '{$title}' |
    curl -fsS -u "admin:$admin" -H 'Content-Type: application/json' -d @- "$url/v1/categories" | jq -er .id)
  curl -fsS -u "admin:$admin" "$url/v1/categories" |
    jq -e --argjson id "$category" --arg title "check $runtime" 'any(.[]; .id == $id and .title == $title)' >/dev/null || {
    echo "EX-30: Miniflux on $runtime does not list the category it stored" >&2
    return 1
  }
  echo "EX-30: Miniflux $version on $runtime answers /healthcheck, stored and listed category $category"
}

# EX-6: what a broken or not ready pod leaves to read.
describe_pods() { # namespace pod...
  local ns=$1 pod
  shift
  for pod; do
    kubectl -n "$ns" describe pod "$pod" >&2 || true
    kubectl -n "$ns" logs "$pod" --all-containers --previous --tail=50 >&2 ||
      kubectl -n "$ns" logs "$pod" --all-containers --tail=50 >&2 || true
  done
}
# EX-6: stop the rollout status as soon as a pod is broken.
watch_pods() {
  local bad now seen=''
  while sleep 10; do
    bad=$(kubectl get pods -A -o json | jq -r '.items[]
      | select([.status.initContainerStatuses[]?, .status.containerStatuses[]?] | any(
          .restartCount > 3 or (.state.waiting.reason | IN("CrashLoopBackOff", "ImagePullBackOff",
            "CreateContainerConfigError", "InvalidImageName"))))
      | "\(.metadata.namespace) \(.metadata.name)"') || continue
    # EX-6: broken on two polls in a row.
    now=$bad
    bad=$(comm -12 <(sort <<<"$seen") <(sort <<<"$now"))
    seen=$now
    [[ -n $bad ]] || continue
    echo "EX-6: broken pods, stopping the check" >&2
    while read -r ns pod; do
      describe_pods "$ns" "$pod"
    done <<<"$bad"
    pkill -P $$ # check's children: the command it waits for and this watch
    return
  done
}
# EX-6: a kubectl rollout status that prints the namespace on a timeout.
install_wait() { # namespace kubectl-arguments
  local ns=$1 s
  shift
  kubectl -n "$ns" "$@" && return
  s=$?
  kubectl -n "$ns" get events --sort-by=.lastTimestamp >&2 || true
  kubectl -n "$ns" get pods -o wide >&2 || true
  # shellcheck disable=SC2046 # one pod name per word
  describe_pods "$ns" $(kubectl -n "$ns" get pods -o json | jq -r '.items[]
    | select(.status.phase != "Succeeded" and (any(.status.conditions[]?;
        .type == "Ready" and .status == "True") | not)) | .metadata.name')
  return "$s"
}

# EX-30, EX-12: the target cluster on kind. The Namespace first, because
# kubectl applies the directory miniflux before the file next to it. Then
# the database, in place of Compose's depends_on: Miniflux exits while
# PostgreSQL refuses connections, and EX-6 stops the check on its restarts.
# The node image of the workflow's kind release; Renovate updates both together.
# renovate: datasource=docker depName=kindest/node
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
kind create cluster --name "$cluster" --wait 120s --image "$KIND_NODE_IMAGE"
watch_pods &
watcher=$!
t=$SECONDS
kubectl apply -f compiled/cluster/manifests/miniflux-namespace.yml >/dev/null
kubectl apply -R -f compiled/cluster/manifests -l name=miniflux-db >/dev/null
install_wait miniflux rollout status statefulset/miniflux-db --timeout=300s
kubectl apply -R -f compiled/cluster/manifests >/dev/null
install_wait miniflux rollout status deployment/miniflux --timeout=300s
echo "deployed to kind in $((SECONDS - t))s"
kubectl -n miniflux port-forward service/miniflux 18080:80 >/dev/null &
forward=$!
smoke kind http://127.0.0.1:18080
kill "$forward" "$watcher" 2>/dev/null || true

# EX-30: the target compose under docker compose on this host, from the
# output compiled without --reveal. kapitan refs reveals it into compose's
# stdin, so no file holds the passwords.
docker compose version
t=$SECONDS
"${py[@]}" kapitan refs --refs-path "$tmp/refs" --reveal -f "$tmp/before/compiled/compose/compose.yml" |
  "${compose[@]}" -f - up -d --wait --wait-timeout 300 || {
  "${compose[@]}" ps -a >&2 || true
  "${compose[@]}" logs --tail=50 >&2 || true
  exit 1
}
echo "started with docker compose in $((SECONDS - t))s"
"${compose[@]}" ps --format '{{.Service}} {{.Image}} {{.Status}}'
smoke compose http://127.0.0.1:8080
echo "compose-kubernetes: passed in $((SECONDS - started))s"
